# Copy to .env for Docker Compose, or /etc/tweetos.env for systemd.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_ALLOWED_USER_ID=REPLACE_WITH_YOUR_NUMERIC_TELEGRAM_ID
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# Exact ID of a text model accessible to your OpenAI API project, supporting Responses.
OPENAI_MODEL=REPLACE_WITH_MODEL_ID
OPENAI_MAX_OUTPUT_TOKENS=1800
# Your X username, without @. Empty means no account specified.
TWEETOS_X_ACCOUNT=
# Docker: host folder containing tweets.jsonl, style.md and corpus-summary.json.
# Relative to compose.yaml, or an absolute path. Never commit personal data.
TWEETOS_HISTORY_DIR=./data/references
# systemd: paths below are used directly; Docker overrides these container paths.
TWEETOS_STATE_DIR=/var/lib/tweetos
TWEETOS_PERSONAL_DIR=/var/lib/tweetos/references
